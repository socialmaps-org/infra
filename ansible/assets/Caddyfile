            body "Unauthorized IP"
            close
        }

        reverse_proxy victoria-logs:9428
    }
}

api.socialmaps.org {
    log

    reverse_proxy socialmaps-api:8080
}

app.socialmaps.org {
    log

    reverse_proxy socialmaps-webapp:80
}

