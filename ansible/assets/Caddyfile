auth.socialmaps.org {
    @not_trusted_ip not remote_ip 10.0.0.2/32
    @public_paths   path /realms/* /resources/* /.well-known/*

    log

    handle @public_paths {
        reverse_proxy keycloak:8080
    }

    handle {
        respond @not_trusted_ip 403 {
            body "Unauthorized IP"
            close
        }
        reverse_proxy keycloak:8080
    }
}

